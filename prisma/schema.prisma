generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User টেবিল ডিজাইন
model User {
  id        Int      @id @default(autoincrement()) // Primary Key
  email     String   @unique
  name      String?  // ? মানে হলো এটি Optional (Nullable)
  posts     Post[]   // রিলেশন: একজন ইউজারের অনেকগুলো Post থাকতে পারে
  createdAt DateTime @default(now())
}

// Post টেবিল ডিজাইন
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  
  // রিলেশন তৈরি (Foreign Key)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}